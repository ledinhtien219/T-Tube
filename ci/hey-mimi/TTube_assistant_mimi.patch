+package com.carhud.aaproxy
+
+import android.content.Context
+
+/** Cài đặt của trợ lý. Mọi thứ nằm trong SharedPreferences chung `carhud_settings`. */
+internal object AssistantConfig {
+    const val DEFAULT_NAME = "Mimi"
+    const val PREF_ENABLED = "assistant_enabled"
+    const val PREF_NAME = "assistant_name"
+    const val PREF_SPEAK = "assistant_speak_reply"
+    const val PREF_NAV_APP = "assistant_nav_app" // auto | waze | gmaps
+    const val PREF_AUTO_PARK = "assistant_auto_save_parking"
+
+    private fun prefs(c: Context) = c.applicationContext.getSharedPreferences(SettingsActivity.PREFS, Context.MODE_PRIVATE)
+
+    fun isEnabled(c: Context) = prefs(c).getBoolean(PREF_ENABLED, true)
+    fun name(c: Context): String = prefs(c).getString(PREF_NAME, DEFAULT_NAME)?.trim().orEmpty().ifBlank { DEFAULT_NAME }
+    fun speakReply(c: Context) = prefs(c).getBoolean(PREF_SPEAK, true)
+    fun navApp(c: Context): String = prefs(c).getString(PREF_NAV_APP, "auto") ?: "auto"
+    fun autoSaveParking(c: Context) = prefs(c).getBoolean(PREF_AUTO_PARK, true)
+}
diff -ruN '--exclude=.git' '--exclude=.kotlin' a/app/src/main/java/com/carhud/aaproxy/AssistantIntent.kt b/app/src/main/java/com/carhud/aaproxy/AssistantIntent.kt
--- a/app/src/main/java/com/carhud/aaproxy/AssistantIntent.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/app/src/main/java/com/carhud/aaproxy/AssistantIntent.kt	2026-10-29 07:59:49.709818208 +0000
@@ -0,0 +1,216 @@
+package com.carhud.aaproxy
+
+import java.text.Normalizer
+
+/** Những việc trợ lý hiểu được. [None] = để luồng giọng nói cũ (nhạc/TV/web) tự xử lý. */
+internal sealed class AssistantIntent {
+    object Greeting : AssistantIntent()
+    object Help : AssistantIntent()
+    object Time : AssistantIntent()
+    object Date : AssistantIntent()
+    object Weather : AssistantIntent()
+    object SaveParking : AssistantIntent()
+    object QueryParking : AssistantIntent()
+    object SaveHome : AssistantIntent()
+    object GoHome : AssistantIntent()
+    object GoParking : AssistantIntent()
+    data class Navigate(val place: String) : AssistantIntent()
+    data class Nearby(val label: String, val query: String) : AssistantIntent()
+    object Pause : AssistantIntent()
+    object Resume : AssistantIntent()
+    object Next : AssistantIntent()
+    object Previous : AssistantIntent()
+    object VolumeUp : AssistantIntent()
+    object VolumeDown : AssistantIntent()
+    data class OpenApp(val spoken: String) : AssistantIntent()
+    object None : AssistantIntent()
+}
+
+/**
+ * Thuần Kotlin (không dùng Android API) nên test được bằng JUnit thường.
+ * Nguyên tắc: chỉ nhận lệnh khi KHỚP RÕ RÀNG. Câu như "phát nhạc Sơn Tùng" luôn
+ * rơi về [AssistantIntent.None] để không phá luồng tìm nhạc hiện tại.
+ */
+internal object AssistantIntentParser {
+
+    /** Bỏ dấu nhưng GIỮ NGUYÊN độ dài chuỗi, để cắt lại phần tên địa điểm có dấu từ câu gốc. */
+    fun fold1to1(text: String): String {
+        val nfc = Normalizer.normalize(text, Normalizer.Form.NFC)
+        val sb = StringBuilder(nfc.length)
+        for (c in nfc) {
+            val base = Normalizer.normalize(c.toString(), Normalizer.Form.NFD).firstOrNull() ?: c
+            sb.append(
+                when (base) {
+                    'đ', 'Đ' -> 'd'
+                    else -> base.lowercaseChar()
+                }
+            )
+        }
+        return sb.toString()
+    }
+
+    private val fillerHead = Regex("""^(?:(?:hay|vui long|lam on|cho toi|giup toi|giup minh|cho minh|toi muon|minh muon|toi can|minh can)\s+)+""")
+    private val fillerTail = Regex("""(?:\s+(?:di|nhe|nao|giup toi|giup minh|cho toi|cho minh|ngay|luon|nua|duoc khong|dum))+$""")
+
+    private val greeting = Regex("""^(?:xin chao|chao|hello|hi|alo|chao buoi (?:sang|trua|chieu|toi))(?:\s+ban)?$""")
+    private val help = Regex("""\b(?:ban|em|tro ly)\s+(?:lam|biet)\s+(?:duoc\s+)?(?:gi|nhung gi)\b|\b(?:huong dan|tro giup)\b|\bgiup duoc gi\b""")
+    private val timeQ = Regex("""\bmay gio\b|\bgio hien tai\b|\bxem gio\b|\bbao nhieu gio\b""")
+    private val dateQ = Regex("""\bhom nay\s+(?:la\s+)?(?:thu may|ngay may|ngay bao nhieu)\b|\bngay bao nhieu\b|\bthu may\b|\bam lich\b|\bngay thang\b""")
+    private val weatherQ = Regex("""\bthoi tiet\b|\bnhiet do\b|\btroi\s+(?:co\s+)?(?:mua|nang|nong|lanh|ret)\b|\bbao nhieu do\b|\bnong khong\b|\blanh khong\b|\bco mua khong\b""")
+
+    private val queryParking = Regex("""\b(?:(?:xe|cho do xe|vi tri do xe)\s+(?:cua\s+)?(?:toi|minh)\s+(?:dang\s+)?(?:do\s+)?(?:o\s+)?dau|(?:toi|minh)\s+(?:da\s+)?do xe\s+(?:o|tai)\s+dau|tim xe(?:\s+(?:cua\s+)?(?:toi|minh))?|cho do xe\s+(?:o\s+)?dau|xe\s+(?:o\s+)?dau)\b""")
+    private val saveParking = Regex("""\b(?:(?:nho|luu|danh dau|ghi nho)\s+(?:giup\s+(?:toi|minh)\s+)?(?:cho do xe|vi tri do xe|vi tri xe|noi do xe|cho nay|vi tri nay|day)|(?:toi|minh)\s+(?:vua\s+|dang\s+)?do xe\s+(?:o|tai)\s+day|do xe\s+(?:o|tai)\s+day|xe\s+(?:o|tai)\s+day)\b""")
+
+    private val saveHome = Regex("""\b(?:dat|luu|dung|chon|nho)\s+(?:day\s+la\s+nha|nha\s+(?:o|tai)\s+day|vi tri nay la nha)\b|\bnha\s+(?:toi|minh)\s+(?:o|tai)\s+day\b""")
+    private val goHome = Regex("""^(?:(?:dan duong|chi duong|di|cho toi di|dua toi)\s+)?(?:ve|toi|den)\s+nha(?:\s+(?:toi|minh))?$|^(?:ve nha)$""")
+
+    private val goParking = Regex("""^(?:dan duong|chi duong|dan toi|dan den|dua toi|chi toi|di)\s*(?:toi|den|ve|ra)?\s+(?:cho do xe|vi tri do xe|xe cua toi|xe cua minh|xe toi|xe minh|xe)$""")
+    private val navigate = Regex("""^(?:dan duong|chi duong|dan toi|dan den|di toi|di den|tim duong|tim duong di|chi toi|dua toi|navigate to|dan duong den|dan duong toi|chi duong den|chi duong toi)\s*(?:toi|den|ra|qua|vao|ve)?\s+(.+)$""")
+
+    private val nearbyCategories = listOf(
+        Regex("""cay xang|tram xang|do xang""") to ("cây xăng" to "cây xăng"),
+        Regex("""\batm\b|cay atm|may atm""") to ("ATM" to "ATM"),
+        Regex("""tram sac|sac xe dien|tram sac xe""") to ("trạm sạc" to "trạm sạc xe điện"),
+        Regex("""bai do xe|cho do xe gan|noi do xe|gui xe""") to ("bãi đỗ xe" to "bãi đỗ xe"),
+        Regex("""tiem sua xe|sua xe|garage|gara""") to ("tiệm sửa xe" to "tiệm sửa xe"),
+        Regex("""benh vien|phong kham|cap cuu""") to ("bệnh viện" to "bệnh viện"),
+        Regex("""nha thuoc|hieu thuoc""") to ("nhà thuốc" to "nhà thuốc"),
+        Regex("""quan ca phe|ca phe|cafe|coffee""") to ("quán cà phê" to "quán cà phê"),
+        Regex("""quan an|nha hang|an uong|an com""") to ("quán ăn" to "quán ăn"),
+        Regex("""sieu thi|cua hang tien loi""") to ("siêu thị" to "siêu thị"),
+        Regex("""khach san|nha nghi""") to ("khách sạn" to "khách sạn"),
+        Regex("""nha ve sinh|toilet|nha wc""") to ("nhà vệ sinh" to "nhà vệ sinh"),
+        Regex("""tram dung chan|diem nghi chan""") to ("trạm dừng chân" to "trạm dừng chân")
+    )
+    private val nearbyCue = Regex("""^(?:((?:tim|chi duong|dan duong|di|dan toi|dan den|chi toi|cho toi biet|co)\s*(?:toi|den|ra|qua|vao)?)\s+)?(?:(?:mot|1)\s+)?(.+?)(\s+(?:gan nhat|gan day|gan toi|gan do|o gan day|quanh day|gan minh)(?:\s+khong)?)?$""")
+
+    private val pause = Regex("""^(?:tam dung|dung lai|dung nhac|dung phat|dung video|dung|pause|tat nhac|tat tieng nhac|ngung phat|ngung)$""")
+    private val resume = Regex("""^(?:tiep tuc|phat tiep|choi tiep|tiep tuc phat|bat lai|resume|play tiep)$""")
+    private val next = Regex("""^(?:bai (?:sau|tiep|ke tiep|tiep theo)|chuyen bai|bai khac|next|kenh (?:sau|tiep|ke tiep|tiep theo)|chuyen kenh)$""")
+    private val previous = Regex("""^(?:bai truoc|bai vua roi|quay lai bai|quay lai|lui lai|previous|kenh truoc)$""")
+    private val volUp = Regex("""^(?:(?:tang|to|lon)\s+(?:am luong|tieng|volume)(?:\s+(?:len|hon))?|to (?:len|hon)|lon (?:len|hon)|tang am|tang len|to tieng)$""")
+    private val volDown = Regex("""^(?:(?:giam|nho|be)\s+(?:am luong|tieng|volume)(?:\s+(?:xuong|di|hon))?|nho (?:xuong|hon|lai)|be (?:xuong|hon|lai)|giam am|giam xuong|nho tieng)$""")
+
+    private val openApp = Regex("""^(?:mo|bat|vao|chuyen sang|chuyen qua|open|chay)\s+(?:ung dung|app)?\s*(.+)$""")
+
+    private fun nfc(s: String) = Normalizer.normalize(s, Normalizer.Form.NFC)
+
+    /**
+     * Bỏ phần gọi tên đầu câu: "Hey Mimi, ...", "Mimi ơi ...", "OK Mimi ...".
+     * Chấp nhận nhận diện giọng tách chữ ("Mi mi") bằng cách cho phép khoảng trắng giữa các chữ cái của tên.
+     */
+    fun stripWake(original: String, assistantName: String): String {
+        val src = nfc(original)
+        val folded = fold1to1(src)
+        val nameRx = fold1to1(assistantName.trim()).filter { !it.isWhitespace() }
+            .map { Regex.escape(it.toString()) }.joinToString("""\s*""")
+        if (nameRx.isBlank()) return src.trim()
+        val m = Regex("""^\s*(?:(?:hey|he|ok|okay|alo|a lo|xin chao|chao)\s+)?$nameRx(?:\s+oi)?[\s,.!?:;-]*""").find(folded)
+            ?: return src.trim()
+        return src.substring(m.range.last + 1).trim()
+    }
+
+    /** Câu có mở đầu bằng tên trợ lý ("Hey Mimi ...") không? */
+    fun hasWake(original: String, assistantName: String): Boolean =
+        stripWake(original, assistantName).length != nfc(original).trim().length
+
+    fun parse(query: String, assistantName: String = AssistantConfig.DEFAULT_NAME): AssistantIntent {
+        if (query.isBlank()) return AssistantIntent.None
+        val original = stripWake(query, assistantName).trim().trim('.', ',', '!', '?')
+        if (original.isBlank()) return AssistantIntent.Greeting // chỉ gọi tên
+        val raw = fold1to1(original).replace(Regex("""\s+"""), " ").trim()
+        // Cắt từ thừa nhưng giữ bản gốc có dấu để lấy tên địa điểm.
+        val headCut = fillerHead.find(raw)?.range?.let { it.last + 1 } ?: 0
+        val text = raw.substring(headCut).replace(fillerTail, "").trim()
+        val originalTail = collapseSpaces(original).let { if (headCut <= it.length) it.substring(headCut) else it }
+        if (text.isBlank()) return AssistantIntent.None
+
+        if (greeting.matches(text)) return AssistantIntent.Greeting
+        if (help.containsMatchIn(text)) return AssistantIntent.Help
+
+        // Câu hỏi nhanh
+        if (queryParking.containsMatchIn(text)) return AssistantIntent.QueryParking
+        if (saveParking.containsMatchIn(text)) return AssistantIntent.SaveParking
+        if (saveHome.containsMatchIn(text)) return AssistantIntent.SaveHome
+        if (goHome.matches(text)) return AssistantIntent.GoHome
+        if (goParking.matches(text)) return AssistantIntent.GoParking
+        if (weatherQ.containsMatchIn(text)) return AssistantIntent.Weather
+        if (timeQ.containsMatchIn(text)) return AssistantIntent.Time
+        if (dateQ.containsMatchIn(text)) return AssistantIntent.Date
+
+        // Điều khiển phát: chỉ nhận cả câu, tránh nuốt tên bài hát
+        if (pause.matches(text)) return AssistantIntent.Pause
+        if (resume.matches(text)) return AssistantIntent.Resume
+        if (next.matches(text)) return AssistantIntent.Next
+        if (previous.matches(text)) return AssistantIntent.Previous
+        if (volUp.matches(text)) return AssistantIntent.VolumeUp
+        if (volDown.matches(text)) return AssistantIntent.VolumeDown
+
+        // Dẫn đường / tìm quanh đây
+        navigate.find(text)?.let { m ->
+            val g = m.groups[1] ?: return@let
+            val place = originalTail.safeSlice(g.range.first, g.range.last + 1).trim()
+            if (place.isNotBlank()) {
+                nearbyOf(fold1to1(place))?.let { return AssistantIntent.Nearby(it.first, it.second) }
+                return AssistantIntent.Navigate(place)
+            }
+        }
+        nearbyCue.matchEntire(text)?.let { m ->
+            val hasCue = m.groupValues[1].isNotEmpty() || m.groupValues[3].isNotEmpty()
+            val core = m.groupValues[2]
+            // Cần có động từ tìm/đi hoặc từ "gần nhất": tránh bắt nhầm tên bài hát như "cà phê muối".
+            if (hasCue && core.split(' ').size <= 4) {
+                nearbyOf(core)?.let { return AssistantIntent.Nearby(it.first, it.second) }
+            }
+        }
+
+        // Mở ứng dụng: việc khớp đúng tên app do AssistantResolver quyết định
+        openApp.find(text)?.let { m ->
+            val g = m.groups[1] ?: return@let
+            val spoken = originalTail.safeSlice(g.range.first, g.range.last + 1).trim()
+            if (spoken.isNotBlank()) return AssistantIntent.OpenApp(spoken)
+        }
+        return AssistantIntent.None
+    }
+
+    private fun nearbyOf(foldedCore: String): Pair<String, String>? {
+        val core = foldedCore.trim()
+        for ((rx, label) in nearbyCategories) if (rx.containsMatchIn(core)) return label
+        return null
+    }
+
+    private fun String.safeSlice(from: Int, toExclusive: Int): String =
+        substring(from.coerceIn(0, length), toExclusive.coerceIn(0, length))
+
+    private fun collapseSpaces(s: String) = s.replace(Regex("""\s+"""), " ").trim()
+}
+
+/** Khớp tên app nói ra với danh sách app trong lưới (id, tên). Trả null nếu không chắc. */
+internal object AssistantAppResolver {
+    private val aliases = mapOf(
+        "youtube" to listOf("youtube", "you tube", "diu tup", "yutub", "youtube pro"),
+        "tiktok" to listOf("tiktok", "tik tok", "tich tok", "tit tok"),
+        "web" to listOf("trinh duyet", "web", "google", "chrome", "duyet web"),
+        "maps" to listOf("ban do", "google maps", "maps", "gu gon map"),
+        "zing" to listOf("zing", "zing mp3"),
+        "spotify" to listOf("spotify", "sa po ti phai"),
+        "tv360" to listOf("tv360", "tv 360", "ti vi 360"),
+        "vtvgo" to listOf("vtv go", "vtvgo", "ve te ve go")
+    )
+
+    fun resolve(spoken: String, apps: List<Pair<String, String>>): String? {
+        val q = AssistantIntentParser.fold1to1(spoken).replace(Regex("""\s+"""), " ").trim()
+        if (q.isBlank()) return null
+        // TV/IPTV đã có luồng riêng (kênh VTV...), không chặn ở đây.
+        if (q.contains("truyen hinh") || q == "tv" || q == "tivi" || q == "ti vi" || q.startsWith("kenh")) return null
+        val ids = apps.map { it.first }.toSet()
+        for ((id, names) in aliases) if (id in ids && names.any { it == q }) return id
+        apps.firstOrNull { AssistantIntentParser.fold1to1(it.second).trim() == q }?.let { return it.first }
+        // khớp chứa tên (ví dụ "mở tik tok đi" đã bị cắt đuôi) nhưng yêu cầu tên đủ dài
+        apps.firstOrNull {
+            val n = AssistantIntentParser.fold1to1(it.second).trim()
+            n.length >= 4 && (n.contains(q) && q.length >= 4 || q.contains(n))
+        }?.let { return it.first }
+        return null
+    }
+}
diff -ruN '--exclude=.git' '--exclude=.kotlin' a/app/src/main/java/com/carhud/aaproxy/AssistantNavigator.kt b/app/src/main/java/com/carhud/aaproxy/AssistantNavigator.kt
--- a/app/src/main/java/com/carhud/aaproxy/AssistantNavigator.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/app/src/main/java/com/carhud/aaproxy/AssistantNavigator.kt	2026-10-29 07:59:49.709873586 +0000
@@ -0,0 +1,75 @@
+package com.carhud.aaproxy
+
+import android.app.ActivityOptions
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+
+/** Mở app dẫn đường (Waze / Google Maps) với đích đến bằng tên hoặc toạ độ. */
+internal object AssistantNavigator {
+    private val wazePackages = listOf("com.waze.mod", "com.waze")
+    private const val GMAPS = "com.google.android.apps.maps"
+
+    private fun installed(c: Context, pkg: String) =
+        try { c.packageManager.getLaunchIntentForPackage(pkg) != null } catch (_: Throwable) { false }
+
+    private fun wazePkg(c: Context) = wazePackages.firstOrNull { installed(c, it) }
+
+    /** destination = tên/địa chỉ; hoặc truyền lat/lon. walking = đi bộ tới xe. */
+    fun navigate(c: Context, destination: String? = null, lat: Double? = null, lon: Double? = null, walking: Boolean = false): Boolean {
+        val pref = AssistantConfig.navApp(c)
+        val waze = wazePkg(c)
+        val gmaps = installed(c, GMAPS)
+        val order = when (pref) {
+            "waze" -> listOf("waze", "gmaps")
+            "gmaps" -> listOf("gmaps", "waze")
+            else -> if (walking) listOf("gmaps", "waze") else listOf("waze", "gmaps") // Waze không có chế độ đi bộ
+        }
+        for (which in order) {
+            val intent = when {
+                which == "waze" && waze != null -> wazeIntent(waze, destination, lat, lon)
+                which == "gmaps" && gmaps -> gmapsIntent(destination, lat, lon, walking)
+                else -> null
+            } ?: continue
+            if (launch(c, intent)) return true
+        }
+        // Không có app nào: để hệ thống chọn app bản đồ
+        val geo = if (lat != null && lon != null) "geo:$lat,$lon?q=$lat,$lon" else "geo:0,0?q=" + Uri.encode(destination.orEmpty())
+        return launch(c, Intent(Intent.ACTION_VIEW, Uri.parse(geo)))
+    }
+
+    private fun wazeIntent(pkg: String, dest: String?, lat: Double?, lon: Double?): Intent {
+        val uri = if (lat != null && lon != null) "waze://?ll=$lat,$lon&navigate=yes" else "waze://?q=" + Uri.encode(dest.orEmpty()) + "&navigate=yes"
+        return Intent(Intent.ACTION_VIEW, Uri.parse(uri)).setPackage(pkg)
+    }
+
+    private fun gmapsIntent(dest: String?, lat: Double?, lon: Double?, walking: Boolean): Intent {
+        val mode = if (walking) "&mode=w" else ""
+        val q = if (lat != null && lon != null) "$lat,$lon" else Uri.encode(dest.orEmpty())
+        return Intent(Intent.ACTION_VIEW, Uri.parse("google.navigation:q=$q$mode")).setPackage(GMAPS)
+    }
+
+    private fun launch(c: Context, intent: Intent): Boolean {
+        intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        return try {
+            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.UPSIDE_DOWN_CAKE) {
+                val opts = ActivityOptions.makeBasic().apply {
+                    setPendingIntentBackgroundActivityStartMode(ActivityOptions.MODE_BACKGROUND_ACTIVITY_START_ALLOWED)
+                }
+                c.startActivity(intent, opts.toBundle())
+            } else {
+                c.startActivity(intent)
+            }
+            true
+        } catch (_: Throwable) {
+            try {
+                PendingIntent.getActivity(c, 0, intent, PendingIntent.FLAG_UPDATE_CURRENT or PendingIntent.FLAG_IMMUTABLE).send()
+                true
+            } catch (_: Throwable) {
+                false
+            }
+        }
+    }
+}
