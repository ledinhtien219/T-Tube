diff -ruN '--exclude=.git' '--exclude=.kotlin' a/app/src/main/java/com/carhud/aaproxy/TtubeAssistant.kt b/app/src/main/java/com/carhud/aaproxy/TtubeAssistant.kt
--- a/app/src/main/java/com/carhud/aaproxy/TtubeAssistant.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/app/src/main/java/com/carhud/aaproxy/TtubeAssistant.kt	2026-10-29 07:59:49.709890424 +0000
@@ -0,0 +1,215 @@
+package com.carhud.aaproxy
+
+import android.content.Context
+import android.location.Location
+import android.media.AudioManager
+import java.util.Calendar
+import java.util.Locale
+
+/**
+ * Trợ lý giọng nói của TTube.
+ *
+ * Cách hoạt động: VoiceSearchManager nhận giọng → CarPresentation.handleVoiceQuery gọi [handle] TRƯỚC
+ * luồng cũ. Trả true = trợ lý đã xử lý; false = giữ nguyên hành vi cũ (tìm nhạc, mở kênh TV, web...).
+ * Vì vậy bật/tắt trợ lý không làm hỏng các lệnh đang chạy tốt.
+ */
+internal object TtubeAssistant {
+
+    /** CarPresentation cung cấp các thao tác phụ thuộc giao diện xe. */
+    interface Host {
+        val hostContext: Context
+        fun show(text: String)
+        fun openApp(appId: String): Boolean
+        fun appCatalog(): List<Pair<String, String>>
+    }
+
+    fun isEnabled(c: Context) = AssistantConfig.isEnabled(c)
+
+    /**
+     * @param requireWake true khi đang ở TikTok/trình duyệt: lúc đó giọng nói là ô tìm kiếm,
+     * chỉ nhận lệnh trợ lý nếu người dùng gọi tên ("Hey Mimi, ...").
+     */
+    fun handle(host: Host, query: String, requireWake: Boolean = false): Boolean {
+        val c = host.hostContext
+        if (!AssistantConfig.isEnabled(c)) return false
+        val name = AssistantConfig.name(c)
+        if (requireWake && !AssistantIntentParser.hasWake(query, name)) return false
+
+        return when (val intent = AssistantIntentParser.parse(query, name)) {
+            AssistantIntent.None -> false
+            AssistantIntent.Greeting -> { say(host, greeting(c)); true }
+            AssistantIntent.Help -> { say(host, helpText(name)); true }
+            AssistantIntent.Time -> { say(host, timeText()); true }
+            AssistantIntent.Date -> { say(host, dateText()); true }
+            AssistantIntent.Weather -> { say(host, weatherText(c, query)); true }
+            AssistantIntent.SaveParking -> { saveParking(host); true }
+            AssistantIntent.QueryParking -> { queryParking(host); true }
+            AssistantIntent.GoParking -> { goParking(host); true }
+            AssistantIntent.SaveHome -> { saveHome(host); true }
+            AssistantIntent.GoHome -> { goHome(host); true }
+            is AssistantIntent.Navigate -> { navigateTo(host, intent.place); true }
+            is AssistantIntent.Nearby -> { nearby(host, intent); true }
+            AssistantIntent.Pause -> { CarMediaManager.pausePlayback(); host.show("⏸ Đã tạm dừng"); true }
+            AssistantIntent.Resume -> { CarMediaManager.userWantsPlayback = true; CarMediaManager.resumePlayback(); host.show("▶ Tiếp tục phát"); true }
+            AssistantIntent.Next -> { CarMediaManager.playNext(); host.show("⏭ Bài/kênh kế tiếp"); true }
+            AssistantIntent.Previous -> { CarMediaManager.playPrevious(); host.show("⏮ Bài/kênh trước"); true }
+            AssistantIntent.VolumeUp -> { volume(c, up = true); host.show("🔊 Đã tăng âm lượng"); true }
+            AssistantIntent.VolumeDown -> { volume(c, up = false); host.show("🔉 Đã giảm âm lượng"); true }
+            is AssistantIntent.OpenApp -> {
+                val id = AssistantAppResolver.resolve(intent.spoken, host.appCatalog())
+                if (id == null) false else {
+                    val ok = host.openApp(id)
+                    if (ok) host.show("Đang mở ${host.appCatalog().firstOrNull { it.first == id }?.second ?: intent.spoken}")
+                    ok
+                }
+            }
+        }
+    }
+
+    // ---- trả lời: hiện chữ + đọc to -------------------------------------------------------------
+
+    private fun say(host: Host, text: String) {
+        host.show(text)
+        val c = host.hostContext
+        if (AssistantConfig.speakReply(c)) CarTtsManager.speakAssistant(c, text)
+    }
+
+    private fun greeting(c: Context): String {
+        val h = Calendar.getInstance().get(Calendar.HOUR_OF_DAY)
+        val part = when (h) { in 5..10 -> "buổi sáng"; in 11..13 -> "buổi trưa"; in 14..17 -> "buổi chiều"; else -> "buổi tối" }
+        return "Chào $part! Mình là ${AssistantConfig.name(c)}. Bạn cần mình giúp gì?"
+    }
+
+    private fun helpText(name: String) =
+        "Mình là $name. Bạn có thể nói: mấy giờ rồi, thời tiết, dẫn đường đến một địa chỉ, về nhà, " +
+            "tìm cây xăng gần nhất, nhớ chỗ đỗ xe, xe tôi đỗ ở đâu, bài sau, tạm dừng, hoặc mở YouTube."
+
+    private fun period(h: Int) = when (h) { in 5..10 -> "sáng"; in 11..12 -> "trưa"; in 13..17 -> "chiều"; in 18..21 -> "tối"; else -> "đêm" }
+
+    private fun timeText(now: Calendar = Calendar.getInstance()): String {
+        val h = now.get(Calendar.HOUR_OF_DAY)
+        val m = now.get(Calendar.MINUTE)
+        val h12 = (h % 12).let { if (it == 0) 12 else it }
+        return if (m == 0) "Bây giờ là $h12 giờ đúng ${period(h)}." else "Bây giờ là $h12 giờ $m phút ${period(h)}."
+    }
+
+    private fun dateText(now: Calendar = Calendar.getInstance()): String {
+        val d = now.get(Calendar.DAY_OF_MONTH)
+        val m = now.get(Calendar.MONTH) + 1
+        val y = now.get(Calendar.YEAR)
+        val dow = VietnameseLunarHelper.getFormattedSolarDate(now).substringBefore(',')
+        val lunar = try {
+            val (ld, lm) = VietnameseLunarHelper.convertSolar2Lunar(d, m, y)
+            " Âm lịch là ngày $ld tháng $lm."
+        } catch (_: Throwable) { "" }
+        return "Hôm nay là $dow, ngày $d tháng $m năm $y.$lunar"
+    }
+
+    private fun weatherText(c: Context, query: String): String {
+        WeatherManager.start(c)
+        val w = WeatherManager.weatherState.value
+        if (!w.isLoaded) return "Mình chưa có dữ liệu thời tiết. Hãy kiểm tra mạng và định vị rồi hỏi lại nhé."
+        val folded = AssistantIntentParser.fold1to1(query)
+        val future = Regex("""\b(?:ngay mai|mai|tuan nay|tuan sau|cuoi tuan|toi nay|chieu nay)\b""").containsMatchIn(folded)
+        val where = w.location.takeIf { it.isNotBlank() && !it.startsWith("Đang") }?.let { "Ở $it, " }.orEmpty()
+        val head = if (future) "Mình chỉ xem được thời tiết hiện tại. " else ""
+        val body = "hiện ${w.tempC} độ, ${w.conditionText.lowercase(Locale("vi"))}. Độ ẩm ${w.humidity} phần trăm, gió ${w.windSpeedKmh} ki lô mét trên giờ."
+        return head + if (where.isNotEmpty()) where + body else body.replaceFirstChar { it.uppercase() }
+    }
+
+    // ---- chỗ đỗ xe / nhà -----------------------------------------------------------------------
+
+    private fun currentFix(): Location? = GpsSpeedManager.lastLocation.value
+
+    private fun saveParking(host: Host) {
+        val c = host.hostContext
+        val loc = currentFix() ?: return say(host, "Mình chưa có vị trí GPS. Hãy bật định vị rồi nói lại nhé.")
+        AssistantStore.saveParking(c, loc, null)
+        say(host, "Đã nhớ chỗ đỗ xe.")
+        AssistantGeocoder.reverse(c, loc.latitude, loc.longitude) { label -> label?.let { AssistantStore.setParkingLabel(c, it) } }
+    }
+
+    private fun queryParking(host: Host) {
+        val c = host.hostContext
+        val spot = AssistantStore.parking(c)
+            ?: return say(host, "Mình chưa nhớ chỗ đỗ xe nào. Khi đỗ xe, hãy nói: nhớ chỗ đỗ xe.")
+        fun reply(label: String?) {
+            val whenText = whenText(spot.savedAt)
+            val distText = currentFix()?.let { loc ->
+                val r = FloatArray(1)
+                Location.distanceBetween(loc.latitude, loc.longitude, spot.lat, spot.lon, r)
+                ", cách bạn ${distanceText(r[0])}"
+            }.orEmpty()
+            val place = label?.let { "ở $it" } ?: "ở vị trí đã lưu"
+            say(host, "Xe bạn đỗ $place, $whenText$distText. Nói “dẫn đường đến xe” để mình chỉ đường nhé.")
+        }
+        if (spot.label != null) return reply(spot.label)
+        AssistantGeocoder.reverse(c, spot.lat, spot.lon) { label ->
+            label?.let { AssistantStore.setParkingLabel(c, it) }
+            reply(label)
+        }
+    }
+
+    private fun goParking(host: Host) {
+        val c = host.hostContext
+        val spot = AssistantStore.parking(c)
+            ?: return say(host, "Mình chưa nhớ chỗ đỗ xe nào để dẫn đường.")
+        say(host, "Đang chỉ đường tới chỗ đỗ xe.")
+        if (!AssistantNavigator.navigate(c, lat = spot.lat, lon = spot.lon, walking = true)) host.show("Không mở được app bản đồ.")
+    }
+
+    private fun saveHome(host: Host) {
+        val c = host.hostContext
+        val loc = currentFix() ?: return say(host, "Mình chưa có vị trí GPS. Hãy bật định vị rồi nói lại nhé.")
+        AssistantStore.saveHome(c, loc, null)
+        say(host, "Đã đặt vị trí này là nhà của bạn.")
+        AssistantGeocoder.reverse(c, loc.latitude, loc.longitude) { label -> label?.let { AssistantStore.setHomeLabel(c, it) } }
+    }
+
+    private fun goHome(host: Host) {
+        val c = host.hostContext
+        val home = AssistantStore.home(c)
+            ?: return say(host, "Bạn chưa đặt nhà. Khi đang ở nhà, hãy nói: đặt nhà ở đây.")
+        say(host, "Đang dẫn đường về nhà.")
+        if (!AssistantNavigator.navigate(c, lat = home.lat, lon = home.lon)) host.show("Không mở được app dẫn đường.")
+    }
+
+    // ---- dẫn đường -----------------------------------------------------------------------------
+
+    private fun navigateTo(host: Host, place: String) {
+        say(host, "Đang dẫn đường đến $place.")
+        if (!AssistantNavigator.navigate(host.hostContext, destination = place)) host.show("Không mở được app dẫn đường.")
+    }
+
+    private fun nearby(host: Host, n: AssistantIntent.Nearby) {
+        say(host, "Đang tìm ${n.label} gần nhất.")
+        if (!AssistantNavigator.navigate(host.hostContext, destination = n.query + " gần nhất")) host.show("Không mở được app dẫn đường.")
+    }
+
+    // ---- tiện ích ------------------------------------------------------------------------------
+
+    private fun volume(c: Context, up: Boolean) {
+        try {
+            val am = c.getSystemService(Context.AUDIO_SERVICE) as AudioManager
+            val dir = if (up) AudioManager.ADJUST_RAISE else AudioManager.ADJUST_LOWER
+            repeat(2) { am.adjustStreamVolume(AudioManager.STREAM_MUSIC, dir, if (it == 1) AudioManager.FLAG_SHOW_UI else 0) }
+        } catch (_: Throwable) {
+        }
+    }
+
+    private fun distanceText(meters: Float): String =
+        if (meters < 1000f) "${(meters / 10).toInt() * 10} mét" else String.format(Locale.US, "%.1f", meters / 1000f).replace('.', ',') + " ki lô mét"
+
+    private fun whenText(savedAt: Long): String {
+        val saved = Calendar.getInstance().apply { timeInMillis = savedAt }
+        val now = Calendar.getInstance()
+        val h = saved.get(Calendar.HOUR_OF_DAY)
+        val m = saved.get(Calendar.MINUTE)
+        val clock = if (m == 0) "$h giờ" else "$h giờ $m"
+        val sameDay = saved.get(Calendar.YEAR) == now.get(Calendar.YEAR) && saved.get(Calendar.DAY_OF_YEAR) == now.get(Calendar.DAY_OF_YEAR)
+        if (sameDay) return "lúc $clock"
+        val yesterday = (now.clone() as Calendar).apply { add(Calendar.DAY_OF_YEAR, -1) }
+        val wasYesterday = saved.get(Calendar.YEAR) == yesterday.get(Calendar.YEAR) && saved.get(Calendar.DAY_OF_YEAR) == yesterday.get(Calendar.DAY_OF_YEAR)
+        return if (wasYesterday) "hôm qua lúc $clock" else "lúc $clock ngày ${saved.get(Calendar.DAY_OF_MONTH)} tháng ${saved.get(Calendar.MONTH) + 1}"
+    }
+}
