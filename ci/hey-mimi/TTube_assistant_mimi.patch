+package com.carhud.aaproxy
+
+import android.content.Context
+import android.location.Geocoder
+import android.location.Location
+import android.os.Handler
+import android.os.Looper
+import java.util.Locale
+
+/** Nơi lưu "chỗ đỗ xe" và "nhà". Dùng commit() vì process có thể bị kill ngay khi rút cáp. */
+internal object AssistantStore {
+    data class Spot(val lat: Double, val lon: Double, val savedAt: Long, val label: String?)
+
+    private const val PREFS = "assistant_store"
+
+    private fun p(c: Context) = c.applicationContext.getSharedPreferences(PREFS, Context.MODE_PRIVATE)
+
+    private fun save(c: Context, key: String, loc: Location, label: String?) {
+        p(c).edit()
+            .putLong("${key}_lat", java.lang.Double.doubleToRawLongBits(loc.latitude))
+            .putLong("${key}_lon", java.lang.Double.doubleToRawLongBits(loc.longitude))
+            .putLong("${key}_at", System.currentTimeMillis())
+            .putString("${key}_label", label)
+            .commit()
+    }
+
+    private fun read(c: Context, key: String): Spot? {
+        val sp = p(c)
+        if (!sp.contains("${key}_lat")) return null
+        return Spot(
+            java.lang.Double.longBitsToDouble(sp.getLong("${key}_lat", 0L)),
+            java.lang.Double.longBitsToDouble(sp.getLong("${key}_lon", 0L)),
+            sp.getLong("${key}_at", 0L),
+            sp.getString("${key}_label", null)
+        )
+    }
+
+    private fun setLabel(c: Context, key: String, label: String) {
+        if (p(c).contains("${key}_lat")) p(c).edit().putString("${key}_label", label).apply()
+    }
+
+    fun saveParking(c: Context, loc: Location, label: String? = null) = save(c, "parking", loc, label)
+    fun parking(c: Context): Spot? = read(c, "parking")
+    fun setParkingLabel(c: Context, label: String) = setLabel(c, "parking", label)
+
+    fun saveHome(c: Context, loc: Location, label: String? = null) = save(c, "home", loc, label)
+    fun home(c: Context): Spot? = read(c, "home")
+    fun setHomeLabel(c: Context, label: String) = setLabel(c, "home", label)
+}
+
+/** Lưu vị trí đỗ khi rút cáp / Android Auto ngắt kết nối. Gọi ĐỒNG BỘ trước khi app thoát. */
+internal object AssistantParking {
+    private const val MAX_FIX_AGE_MS = 15 * 60 * 1000L
+
+    fun autoSaveOnDisconnect(context: Context) {
+        try {
+            if (!AssistantConfig.isEnabled(context) || !AssistantConfig.autoSaveParking(context)) return
+            val loc = GpsSpeedManager.lastLocation.value ?: return
+            if (System.currentTimeMillis() - loc.time > MAX_FIX_AGE_MS) return
+            AssistantStore.saveParking(context, loc, null)
+        } catch (_: Throwable) {
+        }
+    }
+}
+
+/** Đổi toạ độ → địa chỉ ngắn. Có thể thất bại (không mạng / máy không có Geocoder) → trả null. */
+internal object AssistantGeocoder {
+    fun reverse(context: Context, lat: Double, lon: Double, done: (String?) -> Unit) {
+        val app = context.applicationContext
+        Thread {
+            val result = try {
+                if (!Geocoder.isPresent()) null else {
+                    @Suppress("DEPRECATION")
+                    val a = Geocoder(app, Locale("vi", "VN")).getFromLocation(lat, lon, 1)?.firstOrNull()
+                    a?.takeIf { it.maxAddressLineIndex >= 0 }?.getAddressLine(0)?.let { shorten(it) }
+                        ?: listOfNotNull(a?.thoroughfare, a?.subLocality, a?.locality).joinToString(", ").takeIf { it.isNotBlank() }
+                }
+            } catch (_: Throwable) {
+                null
+            }
+            Handler(Looper.getMainLooper()).post { done(result) }
+        }.start()
+    }
+
+    /** "25 Trần Duy Hưng, Trung Hòa, Cầu Giấy, Hà Nội, Việt Nam" → "25 Trần Duy Hưng, Trung Hòa, Cầu Giấy" */
+    fun shorten(full: String): String? {
+        val parts = full.split(',').map { it.trim() }.filter { it.isNotEmpty() && !it.equals("Việt Nam", true) && !it.equals("Vietnam", true) }
+        return parts.take(3).joinToString(", ").takeIf { it.isNotBlank() }
+    }
+}
