diff -ruN '--exclude=.git' '--exclude=.kotlin' a/app/src/test/java/com/carhud/aaproxy/AssistantIntentParserTest.kt b/app/src/test/java/com/carhud/aaproxy/AssistantIntentParserTest.kt
--- a/app/src/test/java/com/carhud/aaproxy/AssistantIntentParserTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/app/src/test/java/com/carhud/aaproxy/AssistantIntentParserTest.kt	2026-10-29 07:59:49.751487410 +0000
@@ -0,0 +1,108 @@
+package com.carhud.aaproxy
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Test
+
+class AssistantIntentParserTest {
+    private val cases: List<Pair<String, AssistantIntent>> = listOf(
+        "mấy giờ rồi" to AssistantIntent.Time,
+        "Hey Mimi, mấy giờ rồi?" to AssistantIntent.Time,
+        "Mi mi ơi bây giờ là mấy giờ" to AssistantIntent.Time,
+        "hôm nay thứ mấy" to AssistantIntent.Date,
+        "hôm nay ngày bao nhiêu" to AssistantIntent.Date,
+        "thời tiết hôm nay thế nào" to AssistantIntent.Weather,
+        "hôm nay trời có mưa không" to AssistantIntent.Weather,
+        "nhiệt độ bao nhiêu" to AssistantIntent.Weather,
+        "nhớ chỗ đỗ xe" to AssistantIntent.SaveParking,
+        "tôi vừa đỗ xe ở đây" to AssistantIntent.SaveParking,
+        "đánh dấu chỗ đỗ xe" to AssistantIntent.SaveParking,
+        "xe tôi đỗ ở đâu" to AssistantIntent.QueryParking,
+        "tôi đã đỗ xe ở đâu" to AssistantIntent.QueryParking,
+        "tìm xe của tôi" to AssistantIntent.QueryParking,
+        "dẫn đường đến xe" to AssistantIntent.GoParking,
+        "về nhà" to AssistantIntent.GoHome,
+        "dẫn đường về nhà" to AssistantIntent.GoHome,
+        "đặt nhà ở đây" to AssistantIntent.SaveHome,
+        "dẫn đường đến 25 Trần Duy Hưng" to AssistantIntent.Navigate("25 Trần Duy Hưng"),
+        "chỉ đường tới sân bay Nội Bài" to AssistantIntent.Navigate("sân bay Nội Bài"),
+        "Hey Mimi dẫn đường đến Vincom Bà Triệu đi" to AssistantIntent.Navigate("Vincom Bà Triệu"),
+        "tìm cây xăng gần nhất" to AssistantIntent.Nearby("cây xăng", "cây xăng"),
+        "chỉ đường đến cây xăng gần nhất" to AssistantIntent.Nearby("cây xăng", "cây xăng"),
+        "ATM gần nhất" to AssistantIntent.Nearby("ATM", "ATM"),
+        "tìm quán cà phê gần đây" to AssistantIntent.Nearby("quán cà phê", "quán cà phê"),
+        "tìm nhà thuốc gần nhất" to AssistantIntent.Nearby("nhà thuốc", "nhà thuốc"),
+        "tạm dừng" to AssistantIntent.Pause,
+        "dừng lại" to AssistantIntent.Pause,
+        "tiếp tục" to AssistantIntent.Resume,
+        "phát tiếp" to AssistantIntent.Resume,
+        "bài sau" to AssistantIntent.Next,
+        "bài tiếp theo đi" to AssistantIntent.Next,
+        "bài trước" to AssistantIntent.Previous,
+        "tăng âm lượng" to AssistantIntent.VolumeUp,
+        "to lên" to AssistantIntent.VolumeUp,
+        "giảm âm lượng" to AssistantIntent.VolumeDown,
+        "nhỏ xuống" to AssistantIntent.VolumeDown,
+        "mở YouTube" to AssistantIntent.OpenApp("YouTube"),
+        "mở ứng dụng TikTok" to AssistantIntent.OpenApp("TikTok"),
+        "Mimi" to AssistantIntent.Greeting,
+        "xin chào" to AssistantIntent.Greeting,
+        "bạn làm được gì" to AssistantIntent.Help,
+        "phát nhạc Sơn Tùng" to AssistantIntent.None,
+        "mở bài Nơi này có anh" to AssistantIntent.OpenApp("bài Nơi này có anh"),
+        "bài hát Mưa trên phố" to AssistantIntent.None,
+        "nghe nhạc trẻ" to AssistantIntent.None,
+        "VTV1" to AssistantIntent.None,
+        "phát VTV3" to AssistantIntent.None,
+        "mở kênh HTV7" to AssistantIntent.OpenApp("kênh HTV7"),
+        "cà phê muối" to AssistantIntent.None,
+        "Tiếng gọi nơi hoang vu" to AssistantIntent.None,
+        "dừng chân bên em" to AssistantIntent.None,
+        "Đi về nhà" to AssistantIntent.GoHome,
+        "về nhà nhé" to AssistantIntent.GoHome,
+        "có cây xăng nào gần đây không" to AssistantIntent.Nearby("cây xăng", "cây xăng"),
+        "đi ăn cơm" to AssistantIntent.Nearby("quán ăn", "quán ăn"),
+        "tìm lại bầu trời" to AssistantIntent.None,
+        "bật nhạc cà phê" to AssistantIntent.OpenApp("nhạc cà phê"),
+    )
+
+    @Test
+    fun `parse tung cau noi`() {
+        for ((spoken, expected) in cases) {
+            assertEquals("Câu: $spoken", expected, AssistantIntentParser.parse(spoken, "Mimi"))
+        }
+    }
+
+    @Test
+    fun `ten bai hat va kenh TV khong bi tro ly nuot mat`() {
+        listOf("phát nhạc Sơn Tùng", "bài hát Mưa trên phố", "nghe nhạc trẻ", "VTV1", "phát VTV3", "cà phê muối", "dừng chân bên em", "tìm lại bầu trời")
+            .forEach { assertEquals("Câu: $it", AssistantIntent.None, AssistantIntentParser.parse(it, "Mimi")) }
+    }
+
+    @Test
+    fun `resolver chi nhan dung app va bo qua kenh TV`() {
+        val apps = listOf("youtube" to "YouTube Pro", "iptv" to "IPTV Truyền hình", "web" to "Trình duyệt Web", "tiktok" to "TikTok", "vtvgo" to "VTV Go")
+        assertEquals("youtube", AssistantAppResolver.resolve("YouTube", apps))
+        assertEquals("tiktok", AssistantAppResolver.resolve("tik tok", apps))
+        assertEquals("web", AssistantAppResolver.resolve("trình duyệt", apps))
+        assertEquals("vtvgo", AssistantAppResolver.resolve("VTV Go", apps))
+        assertNull(AssistantAppResolver.resolve("kênh HTV7", apps))
+        assertNull(AssistantAppResolver.resolve("bài Nơi này có anh", apps))
+        assertNull(AssistantAppResolver.resolve("truyền hình", apps))
+    }
+
+    @Test
+    fun `wake word`() {
+        assertEquals(true, AssistantIntentParser.hasWake("Hey Mimi, mấy giờ rồi", "Mimi"))
+        assertEquals(true, AssistantIntentParser.hasWake("Mi mi ơi thời tiết", "Mimi"))
+        assertEquals(false, AssistantIntentParser.hasWake("mấy giờ rồi", "Mimi"))
+        assertEquals("mấy giờ rồi", AssistantIntentParser.stripWake("Hey Mimi, mấy giờ rồi", "Mimi"))
+    }
+
+    @Test
+    fun `fold giu nguyen do dai`() {
+        val s = "Đường Trần Duy Hưng"
+        assertEquals(s.length, AssistantIntentParser.fold1to1(s).length)
+        assertEquals("duong tran duy hung", AssistantIntentParser.fold1to1(s))
+    }
+}
