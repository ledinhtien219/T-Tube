+import test from 'node:test';
+import assert from 'node:assert/strict';
+import {sanitizeHistory} from './mimi-proxy-policy.mjs';
+test('empty or malformed history yields no context',()=>{
+ assert.deepEqual(sanitizeHistory(null),[]);
+ assert.deepEqual(sanitizeHistory([{q:'ok',a:123}, null]),[]);
+});
+test('context limited to last two short pairs',()=>{
+ const items=[{q:'one',a:'1'},{q:'two',a:'2'},{q:'three',a:'3'}];
