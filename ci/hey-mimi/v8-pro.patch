+});
+test('very long values and unexpected fields never reach AI',()=>{
+ assert.deepEqual(sanitizeHistory([{q:'x'.repeat(241),a:'a'}]),[]);
+ assert.deepEqual(sanitizeHistory([{q:'hello',a:'hi',gps:'10,20'}]),[{q:'hello',a:'hi'}]);
+});
