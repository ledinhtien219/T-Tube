+package com.carhud.aaproxy
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class MimiProPolicyTest {
+    @Test fun proControlsRequireExactUtterance() {
+        assertEquals(MimiProPolicy.Action.STOP, MimiProPolicy.action("im lặng"))
+        assertEquals(MimiProPolicy.Action.REPEAT, MimiProPolicy.action("nhắc lại"))
+        assertEquals(MimiProPolicy.Action.MUTE, MimiProPolicy.action("tắt giọng Mimi"))
+        assertEquals(MimiProPolicy.Action.UNMUTE, MimiProPolicy.action("bật giọng Mimi"))
+        assertEquals(MimiProPolicy.Action.STATUS, MimiProPolicy.action("Mimi Pro"))
+        assertEquals(MimiProPolicy.Action.STATUS, MimiProPolicy.action("Pro"))
+        assertEquals(MimiProPolicy.Action.PRIVACY, MimiProPolicy.action("Mimi có gửi vị trí không?"))
+        assertEquals(MimiProPolicy.Action.PRIVACY, MimiProPolicy.action("Có gửi vị trí không?"))
+    }
+    @Test fun mediaTitlesAreNeverControlCommands() {
+        listOf("phát nhạc Im Lặng", "mở video nhắc lại", "tìm nhạc bật giọng nói", "dẫn đường tới Mimi Pro")
+            .forEach { assertEquals(it, MimiProPolicy.Action.NONE, MimiProPolicy.action(it)) }
+    }
+    @Test fun conversationalLanguageDoesNotHijackMediaCommands() {
+        listOf("tại sao trời mưa", "giải thích hệ thống phanh ABS", "có thể kể cho tôi", "cho tôi biết đoạn đường này")
+            .forEach { assertTrue(it, MimiProPolicy.conversational(it)) }
+        listOf("phát nhạc Sơn Tùng", "mở TikTok", "tìm video mới", "dẫn đường về nhà")
+            .forEach { assertFalse(it, MimiProPolicy.conversational(it)) }
+    }
+}
