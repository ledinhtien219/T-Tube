+/** Validate context from opt-in client. Never trust unknown fields from the network. */
+export function sanitizeHistory(input) {
+  if (!Array.isArray(input)) return [];
+  return input.slice(-2).filter(t =>
+    t && typeof t.q === 'string' && typeof t.a === 'string' &&
+    t.q.length <= 240 && t.a.length <= 300
+  ).map(({q,a})=>({q,a}));
+}
