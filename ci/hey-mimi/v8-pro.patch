+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const r=path.resolve(__dirname,'..');
+const read=p=>fs.readFileSync(path.join(r,p),'utf8');
+const src='app/src/main/java/com/carhud/aaproxy/';
+test('AI conversation memory is opt-in and not persisted',()=>{
+ const c=read(src+'AssistantConfig.kt');
+ const smart=read(src+'MimiSmartAssistant.kt');
+ assert.match(c,/PREF_CONTEXT_ENABLED/);
+ assert.match(c,/getBoolean\(PREF_CONTEXT_ENABLED, false\)/);
+ assert.match(smart,/private val recent = ArrayDeque/);
+ assert.match(smart,/recent\.clear\(\)/);
+ assert.match(smart,/while \(recent\.size > 2\)/);
+});
+test('Pro controls offer stop, replay and audio preference',()=>{
+ const car=read(src+'CarPresentation.kt');
+ const tts=read(src+'CarTtsManager.kt');
+ assert.match(car,/MimiProPolicy\.Action\.STOP/);
+ assert.match(car,/MimiProPolicy\.Action\.REPEAT/);
+ assert.match(car,/PREF_SPEAK/);
+ assert.match(tts,/fun stopAssistantSpeech\(\)/);
+});
+test('existing media remains deterministic and Pro answers are only addressed',()=>{
+ const car=read(src+'CarPresentation.kt');
+ assert.match(car,/if \(!explicitMedia && mimiSmartAssistant\.tryHandle/);
+ assert.match(car,/if \(addressed && AssistantConfig\.isEnabled\(context\)\)/);
+ assert.match(car,/if \(currentActiveAppId == "tiktok" && !isDashboardShowing && !explicitMedia\)/);
+});
+test('Pro UI remains compact and wake phrase does not mean continuous mic',()=>{
+ const panel=read(src+'MimiAssistantPanel.kt');
+ const hotword=read(src+'MimiHotwordEngine.kt');
+ assert.match(panel,/captureTimeout\(24_000L\)/);
+ assert.match(hotword,/None is shipped in v6|offline wake-word engine/);
+});
