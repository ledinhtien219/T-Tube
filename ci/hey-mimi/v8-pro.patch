+package com.carhud.aaproxy
+
+/** Deterministic Pro voice shortcuts. Never interpret a quoted song title as a control. */
+internal object MimiProPolicy {
+    enum class Action { NONE, STOP, REPEAT, MUTE, UNMUTE, STATUS, PRIVACY }
+    fun action(text: String): Action {
+        val s = AssistantIntentParser.fold1to1(text).lowercase()
+            .replace(Regex("""[!?.,]+"""), "").replace(Regex("""\s+"""), " ").trim()
+        return when (s) {
+            "im lang", "dung noi", "mimi im lang", "ngung doc", "thoi khong noi nua", "dung tra loi" -> Action.STOP
+            "nhac lai", "noi lai", "lap lai", "doc lai cau tra loi", "noi lai cau vua roi" -> Action.REPEAT
+            "tat giong mimi", "tat doc tra loi", "tat giong noi", "im lang luon" -> Action.MUTE
+            "bat giong mimi", "bat doc tra loi", "bat giong noi", "cho mimi noi" -> Action.UNMUTE
+            "trang thai mimi", "mimi co san sang khong", "kiem tra mimi", "mimi pro", "pro", "co san sang khong" -> Action.STATUS
+            "mimi co gui vi tri khong", "co gui vi tri khong", "du lieu cua toi di dau", "mimi co theo doi toi khong", "co theo doi toi khong" -> Action.PRIVACY
+            else -> Action.NONE
+        }
+    }
+
+    /** A spoken question without punctuation should not silently turn into a YouTube search. */
+    fun conversational(text: String): Boolean {
+        val s = AssistantIntentParser.fold1to1(text).lowercase().trim()
+        if (s.length !in 4..500) return false
+        if (Regex("""^(phat|mo|bat|tim|xem|nghe|choi|chuyen|dung|tam dung|tiep tuc|tang|giam|dan duong|chi duong|ve nha)\b""").containsMatchIn(s)) return false
+        return Regex("""^(tai sao|vi sao|giai thich|la gi|nhu the nao|co the|cho toi biet|ke cho|mimi nghi|the nao|bao nhieu|hom nay co|ban co biet|giup toi hieu)\b""").containsMatchIn(s) || s.contains('?')
+    }
+}
