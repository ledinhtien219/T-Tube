+ assert.doesNotMatch(isolated,/createElement\(['"](?:video|iframe)['"]\)/);
+ assert.match(js,/syncRecommendationPane\(pip\)/);
+ assert.match(isolated,/updatePipChooser\(true\)/);
+ assert.match(isolated,/updatePipChooser\(false\)/);
+});
