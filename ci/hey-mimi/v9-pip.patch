+const {test} = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const src = fs.readFileSync('app/src/main/java/com/carhud/aaproxy/YouTubePlayerHelper.kt','utf8');
+const block = src.match(/val JS_CLEANUP_AND_ADBLOCK: String = """([\s\S]*?)"""\.trimIndent\(\)/);
+assert.ok(block,'Missing YouTube JavaScript injection');
+const js=block[1];
+new Function(js);
