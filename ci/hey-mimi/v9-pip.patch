+class Element {
+  constructor(tag='div') { this.tag=tag; this.children=[]; this.style={}; this.attributes={}; this.isConnected=false; this.className=''; this.textContent=''; this.value=''; this.shadowRoot=null; }
+  appendChild(n){this.children.push(n);n.parent=this;n.isConnected=this.isConnected;return n;}
+  get firstChild(){return this.children[0]??null;}
+  removeChild(n){const i=this.children.indexOf(n);if(i>=0)this.children.splice(i,1);}
+  remove(){this.parent?.removeChild(this);this.isConnected=false;}
+  attachShadow(){const sh=new Element('shadow');sh.isConnected=true;this.shadowRoot=sh;return sh;}
+  setAttribute(k,v){this.attributes[k]=v;}
+  removeAttribute(k){delete this.attributes[k];}
+  getAttribute(k){return this.attributes[k]??null;}
+  addEventListener(t,fn){this['on_'+t]=fn;}
+  click(){this.clicked=true;}
+}
+function setup(items){
+ const pane = new Element('related');pane.isConnected=true;pane.getBoundingClientRect=()=>({width:200,height:200});
+ pane.querySelector=()=>items.length?items[0]:null;
+ pane.querySelectorAll=()=>items;
+ const root=new Element('html');root.isConnected=true;
+ const doc={documentElement:root,
+   createElement(tag){return new Element(tag);},
+   querySelector(selector){return selector==='ytd-watch-flexy #secondary'?pane:null;},
+   querySelectorAll(){return [pane];}};
+ const location={href:'https://www.youtube.com/watch?v=abc123'};
+ const api=new Function('document','location','URL','encodeURIComponent',isolated+ '\nreturn {findRecommendationRoot,collectPipSuggestions,updatePipChooser};')(doc,location,URL,encodeURIComponent);
+ return {api,doc,pane,root};
+}
+function item(href,id,thumb){
+ const link={href,getAttribute(k){return k==='href'?href:k==='aria-label'?'Video '+id:null;},title:''};
+ const img={currentSrc:thumb,getAttribute(){return thumb;}};
+ return {querySelector(s){if(s.includes('a[href'))return link;if(s.includes('img'))return img;return {textContent:'Video '+id};},getAttribute(){return null;}};
+}
+test('PiP uses real YouTube recommendation URLs, removes duplicates, current video and offsite links',()=>{
+ const {api}=setup([
+   item('/watch?v=abc123','current',''),
+   item('/watch?v=first','first','https://i.ytimg.com/vi/first/hqdefault.jpg'),
+   item('https://www.youtube.com/watch?v=second','second',''),
+   item('/watch?v=first','duplicate',''),
+   item('https://evil.example/watch?v=unsafe','unsafe','')
+ ]);
+ api.findRecommendationRoot();
+ const cards=api.collectPipSuggestions();
+ assert.deepEqual(cards.map(c=>c.id),['first','second']);
+ assert.equal(cards[0].href,'/watch?v=first');
+});
+test('PiP displays scrollable multiple selection cards and removes chooser on close',()=>{
+ const {api,root,pane}=setup([item('/watch?v=first','first',''),item('/watch?v=second','second','')]);
+ api.findRecommendationRoot();
+ api.updatePipChooser(true);
+ const host=root.children.find(c=>c.id==='carhud-pip-video-chooser');
+ assert.ok(host,'Mini PiP chooser appears even if YouTube desktop column is narrow');
+ const wrap=host.shadowRoot.children.find(n=>n.tag==='section');
+ const grid=wrap.children.find(n=>n.className==='grid');
+ assert.equal(grid.children.length,2);
+ assert.deepEqual(grid.children.map(c=>c.href),['/watch?v=first','/watch?v=second']);
+ const stylesheet=host.shadowRoot.children.find(n=>n.tag==='style').textContent;
+ assert.match(stylesheet,/overflow-y:auto/);
+ assert.match(stylesheet,/grid-template-columns:repeat\(auto-fill,minmax\(145px,1fr\)\)/);
+ api.updatePipChooser(false);
+ assert.equal(root.children.length,0);
+});
+test('When YouTube has zero recommendations, offer honest search fallback',()=>{
+ const {api,root}=setup([]);
+ api.updatePipChooser(true);
+ const host=root.children[0];
+ const wrap=host.shadowRoot.children.find(n=>n.tag==='section');
+ const form=wrap.children.find(n=>n.tag==='form');
+ const grid=wrap.children.find(n=>n.className==='grid');
+ assert.match(grid.children[0].textContent,/chưa tải gợi ý/);
+ assert.ok(form && form.children.some(n=>n.tag==='input'));
+});
