+package com.carhud.aaproxy
+
+/**
+ * Deterministic, on-device phrases: no network, no fake vehicle capabilities.
+ * Only used for an explicitly addressed request or a deliberately armed second turn.
+ */
+internal object MimiEverydayPhrases {
+    fun reply(text: String): String? {
+        val s = AssistantIntentParser.fold1to1(text)
+            .replace(Regex("""[.!?,;:]+"""), " ").replace(Regex("""\s+"""), " ").trim()
+        return when {
+            Regex("""^(?:cam on|cam on mimi|thank you|thanks|tot lam|gioi qua)(?: nhe| nha| rat nhieu)?$""").matches(s) ->
+                "Mimi luôn sẵn sàng giúp bạn. Chúc bạn lái xe an toàn!"
+            Regex("""^(?:tam biet|hen gap lai|bye bye|chao nhe)(?: mimi)?$""").matches(s) ->
+                "Tạm biệt! Chúc bạn có chuyến đi an toàn."
+            Regex("""^(?:ban ten gi|em ten gi|ten ban la gi|mimi la ai|ban la ai|em la ai)$""").matches(s) ->
+                "Mình là Mimi, trợ lý giọng nói của T-Tube trên Android Auto."
+            Regex("""^(?:toi met qua|minh met qua|buon ngu qua|toi dang buon ngu|toi muon nghi mot chut|met qua)$""").matches(s) ->
+                "Nếu đang lái xe và thấy mệt hoặc buồn ngủ, hãy tìm nơi dừng an toàn để nghỉ. Mimi có thể giúp tìm trạm dừng chân."
+            Regex("""^(?:co can ket noi mang khong|co can mang khong|mimi co can mang khong|mimi co hoat dong offline khong)$""").matches(s) ->
+                "Lệnh giờ, ngày và điều khiển phát có thể dùng không cần AI. Hỏi đáp AI cần kết nối máy chủ HTTPS."
+            Regex("""^(?:mimi co nghe toi khong|ban co nghe khong|nghe ro khong|mimi dang nghe khong)$""").matches(s) ->
+                "Mimi đã nhận được lời bạn nói. Bạn hãy cho mình một yêu cầu nhé."
+            Regex("""^(?:goi cap cuu|goi 115|goi canh sat|goi 113|goi cuu hoa|goi 114|goi cuu ho|goi dien cho ai do)$""").matches(s) ->
+                "Mimi chưa thể tự thực hiện cuộc gọi. Nếu khẩn cấp, hãy dừng xe ở nơi an toàn và dùng điện thoại gọi số cứu hộ phù hợp."
+            else -> null
+        }
+    }
+}
