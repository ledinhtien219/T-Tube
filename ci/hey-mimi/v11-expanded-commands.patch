+package com.carhud.aaproxy
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertNotNull
+import org.junit.Test
+
+class MimiExtendedLanguageTest {
+    @Test fun `extra native driving requests in Vietnamese`() {
+        val examples = listOf(
+            "Mimi tôi cần đổ xăng" to AssistantIntent.Nearby("cây xăng", "cây xăng"),
+            "Mimi sắp hết pin xe điện" to AssistantIntent.Nearby("trạm sạc", "trạm sạc xe điện"),
+            "Mimi tìm quán ăn" to AssistantIntent.Nearby("quán ăn", "quán ăn"),
+            "Mimi tôi đói quá" to AssistantIntent.Nearby("quán ăn", "quán ăn"),
+            "Mimi tìm trạm dừng chân" to AssistantIntent.Nearby("trạm dừng chân", "trạm dừng chân"),
+            "Mimi xe bị thủng lốp" to AssistantIntent.Nearby("tiệm sửa lốp", "tiệm sửa lốp"),
+            "Mimi cần sửa xe" to AssistantIntent.Nearby("tiệm sửa xe", "tiệm sửa xe"),
+            "Mimi về nhà thôi" to AssistantIntent.GoHome,
+            "Mimi bỏ qua bài này" to AssistantIntent.Next,
+            "Mimi video tiếp theo" to AssistantIntent.Next,
+            "Mimi phát bài trước" to AssistantIntent.Previous,
+            "Mimi ngừng nhạc" to AssistantIntent.Pause,
+            "Mimi phát nhạc tiếp" to AssistantIntent.Resume,
+            "Mimi cho nhạc to hơn" to AssistantIntent.VolumeUp,
+            "Mimi cho nhạc nhỏ lại" to AssistantIntent.VolumeDown,
+            "Mimi bây giờ là mấy giờ" to AssistantIntent.Time,
+            "Mimi hôm nay ngày gì" to AssistantIntent.Date,
+            "Mimi trời đang thế nào" to AssistantIntent.Weather,
+            "Mimi chỉ đường tới 123 Hoàng Quốc Việt" to AssistantIntent.Navigate("123 Hoàng Quốc Việt"),
+            "Mimi đưa mình đến sân bay Nội Bài" to AssistantIntent.Navigate("sân bay Nội Bài"),
+        )
+        for ((spoken, expected) in examples) assertEquals(spoken, expected, AssistantIntentParser.parse(spoken, "Mimi"))
+    }
+
+    @Test fun `offline social and emergency replies never fake a phone call`() {
+        for (input in listOf("cảm ơn", "bạn tên gì", "tôi mệt quá", "Mimi có cần mạng không", "gọi cấp cứu", "nghe rõ không")) {
+            val text = input.removePrefix("Mimi ")
+            assertNotNull(input, MimiEverydayPhrases.reply(text))
+        }
+        assertNull(MimiEverydayPhrases.reply("phát bài hát em của ngày hôm qua"))
+        assertNull(MimiEverydayPhrases.reply("mở YouTube"))
+    }
+
+    @Test fun `music and videos stay in the media path`() {
+        listOf("Mimi phát nhạc Sơn Tùng", "Mimi tìm video học lái xe", "Mimi mở video phượt", "Mimi nghe bài Nơi này có anh")
+            .forEach { assertNull(it, MimiEverydayPhrases.reply(AssistantIntentParser.stripWake(it, "Mimi"))) }
+        assertEquals(AssistantIntent.None, AssistantIntentParser.parse("Mimi phát nhạc Sơn Tùng", "Mimi"))
+    }
+}
