@@ -0,0 +1,27 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs=require('fs');
+const path=require('path');
+const root=path.join(__dirname,'..');
+const car=fs.readFileSync(path.join(root,'app/src/main/java/com/carhud/aaproxy/CarPresentation.kt'),'utf8');
+const phrases=fs.readFileSync(path.join(root,'app/src/main/java/com/carhud/aaproxy/MimiEverydayPhrases.kt'),'utf8');
+test('tapping Mimi is an addressed request even in TikTok',()=>{
+ assert.match(car,/MimiAssistantPanel\(context\) \{ startMimiVoiceSearch\(\) \}/);
+ assert.match(car,/mimiTapSession = true/);
+ assert.match(car,/heyMimiConversation\.consume\(now\) \|\| mimiTapSession/);
+});
+test('addressed conversation cannot fall through to video search',()=>{
+ const posAssistant=car.indexOf('mimiSmartAssistant.tryHandle(query, addressed)');
+ const posFallback=car.indexOf('Mimi hiểu bạn đang hỏi');
+ const posTikTok=car.indexOf('currentActiveAppId == "tiktok" && !isDashboardShowing && !explicitMedia');
+ assert.ok(posAssistant>0 && posAssistant<posFallback && posFallback<posTikTok);
+ assert.match(car,/if \(addressed && AssistantConfig\.isEnabled\(context\) && !explicitMedia\)/);
+});
+test('offline replies do not claim to place emergency calls',()=>{
+ assert.match(phrases,/Mimi chưa thể tự thực hiện cuộc gọi/);
+ assert.match(phrases,/Mimi có thể giúp tìm trạm dừng chân/);
+});
+test('native commands preserve explicit media route',()=>{
+ assert.match(car,/val explicitMedia = addressed/);
+ assert.match(car,/!explicitMedia && mimiSmartAssistant.tryHandle/);
+});