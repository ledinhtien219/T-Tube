--- a/app/src/main/java/com/carhud/aaproxy/HeyMimiConversation.kt
+++ b/app/src/main/java/com/carhud/aaproxy/HeyMimiConversation.kt
@@ -0,0 +1,31 @@
+package com.carhud.aaproxy
+
+/**
+ * Two-turn wake phrase for the EXISTING push-to-talk recognition session.
+ *
+ * This class never opens the microphone. The presentation may open one more
+ * short voice session after hearing only the assistant name. This is NOT an
+ * always-on or background hotword detector.
+ */
+internal class HeyMimiConversation(private val timeoutMs: Long = 20_000L) {
+    private var armedUntilMs: Long? = null
+
+    fun isWakeOnly(phrase: String, name: String): Boolean {
+        if (!AssistantIntentParser.hasWake(phrase, name)) return false
+        val rest = AssistantIntentParser.stripWake(phrase, name)
+        return rest.all { it.isWhitespace() || it in ".,?!:;…-–—" }
+    }
+
+    fun arm(nowMs: Long) {
+        armedUntilMs = nowMs + timeoutMs
+    }
+
+    fun isArmed(nowMs: Long): Boolean = armedUntilMs?.let { nowMs <= it } ?: false
+
+    /** Only the immediately following recognized utterance can bypass wake requirements. */
+    fun consume(nowMs: Long): Boolean = isArmed(nowMs).also { cancel() }
+
+    fun cancel() {
+        armedUntilMs = null
+    }
+}
