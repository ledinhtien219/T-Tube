--- a/app/src/test/java/com/carhud/aaproxy/HeyMimiConversationTest.kt
+++ b/app/src/test/java/com/carhud/aaproxy/HeyMimiConversationTest.kt
@@ -0,0 +1,32 @@
+package com.carhud.aaproxy
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class HeyMimiConversationTest {
+    @Test fun `wake only accepts names but not a whole command`() {
+        val c = HeyMimiConversation()
+        listOf("Hey Mimi", "Mimi ơi", "Mi mi ơi!", "OK Mimi...", "hey mimi?")
+            .forEach { assertTrue("Wake: $it", c.isWakeOnly(it, "Mimi")) }
+        listOf("mấy giờ rồi", "phát nhạc Mimi", "Hey Mimi, mấy giờ rồi", "Mimi yêu nhạc")
+            .forEach { assertFalse("Not wake-only: $it", c.isWakeOnly(it, "Mimi")) }
+    }
+
+    @Test fun `next recognition consumes the wake once`() {
+        val c = HeyMimiConversation(timeoutMs = 10_000L)
+        c.arm(1_000L)
+        assertTrue(c.isArmed(9_000L))
+        assertTrue(c.consume(9_000L))
+        assertFalse(c.consume(9_001L))
+    }
+
+    @Test fun `expiry and cancellation do not capture later search`() {
+        val c = HeyMimiConversation(timeoutMs = 10_000L)
+        c.arm(1_000L)
+        assertFalse(c.consume(11_001L))
+        c.arm(12_000L)
+        c.cancel()
+        assertFalse(c.consume(12_500L))
+    }
+}
