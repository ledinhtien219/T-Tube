+package com.carhud.aaproxy
+
+import android.content.Context
+import android.os.Handler
+import android.os.Looper
+import org.json.JSONObject
+import java.net.HttpURLConnection
+import java.net.URL
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * Safe opt-in conversational fallback. The existing deterministic commands keep priority.
+ * No API key, token, raw GPS coordinates, vehicle identifiers, or conversation history
+ * are sent by this Android client. Server owners must implement auth/rate limits.
+ */
+internal class MimiSmartAssistant(private val context: Context) {
+    private val main = Handler(Looper.getMainLooper())
+    private val generation = AtomicInteger()
+
+    /** Invalidates network callbacks when projection is no longer visible. */
+    fun cancel() { generation.incrementAndGet() }
+
+    /** Return true only if this addressed utterance was fully consumed. */
+    fun tryHandle(query: String, addressed: Boolean, show: (String) -> Unit): Boolean {
+        if (!addressed || !AssistantConfig.isEnabled(context)) return false
+        val utterance = AssistantIntentParser.stripWake(query, AssistantConfig.name(context)).trim()
+        if (utterance.isBlank() || !MimiAiPolicy.allowedFallback(utterance)) return false
+
+        MimiAiPolicy.drivingQuestion(utterance)?.let { prompt ->
+            val answer = when (prompt) {
+                "speed" -> {
+                    val loc = GpsSpeedManager.lastLocation.value
+                    if (loc != null && loc.hasSpeed() && System.currentTimeMillis() - loc.time in 0..15_000L)
+                        "Theo GPS, xe đang đi khoảng ${Math.round(loc.speed * 3.6f)} ki lô mét mỗi giờ."
+                    else "Mimi chưa có tốc độ GPS đủ mới. Hãy kiểm tra quyền định vị."
+                }
+                "traffic" -> "Mimi chưa có dữ liệu giao thông trực tiếp. Bạn có thể mở Waze hoặc Google Maps để kiểm tra đường đi."
+                else -> "Mimi sẽ ưu tiên câu trả lời ngắn khi bạn lái xe. Hãy tập trung quan sát đường."
+            }
+            reply(show, answer)
+            return true
+        }
+
+        if (!AssistantConfig.aiEnabled(context)) return false
+        val endpoint = AssistantConfig.aiEndpoint(context)
+        if (!MimiAiPolicy.validEndpoint(endpoint)) {
+            reply(show, "Chưa có máy chủ AI HTTPS hợp lệ. Hãy cài trong mục Trợ lý Mimi trên điện thoại.")
+            return true
+        }
+        val ticket = generation.incrementAndGet()
+        show("Mimi đang tìm câu trả lời…")
+        Thread({
+            val answer = try { request(endpoint, utterance) }
+                catch (_: Exception) { "Mimi chưa kết nối được máy chủ AI. Bạn thử lại khi có mạng nhé." }
+            main.post {
+                if (ticket == generation.get() && AssistantConfig.aiEnabled(context) && AssistantConfig.isEnabled(context))
+                    reply(show, MimiAiPolicy.shortReply(answer))
+            }
+        }, "mimi-ai-https").start()
+        return true
+    }
+
+    private fun reply(show: (String) -> Unit, message: String) {
+        show(message)
+        if (AssistantConfig.speakReply(context)) CarTtsManager.speakAssistant(context, message)
+    }
+
+    private fun request(endpoint: String, message: String): String {
+        val connection = (URL(endpoint).openConnection() as HttpURLConnection)
+        try {
+            connection.requestMethod = "POST"
+            connection.instanceFollowRedirects = false
+            connection.connectTimeout = 5_000
+            connection.readTimeout = 9_000
+            connection.doOutput = true
+            connection.setRequestProperty("Content-Type", "application/json; charset=utf-8")
+            connection.setRequestProperty("Accept", "application/json")
+            val token = AssistantConfig.aiProxyToken(context)
+            if (token.isNotBlank()) connection.setRequestProperty("X-Mimi-Token", token)
+            val bytes = JSONObject().put("message", message.take(500)).put("mode", "driving")
+                .put("locale", "vi-VN").toString().toByteArray(Charsets.UTF_8)
+            connection.outputStream.use { it.write(bytes) }
+            if (connection.responseCode != 200) throw IllegalStateException("AI HTTP failure")
+            val body = connection.inputStream.bufferedReader(Charsets.UTF_8).use { it.readText().take(12_000) }
+            val response = JSONObject(body).optString("reply").trim()
+            if (response.isBlank()) throw IllegalStateException("AI response missing")
+            return response
+        } finally { connection.disconnect() }
+    }
+}
+
+/** Pure policy suitable for JVM tests; no cloud answer may launch apps or control vehicle. */
+internal object MimiAiPolicy {
+    private val media = Regex("""^(phat|mo nhac|nghe nhac|bat nhac|choi nhac|mo tv|mo kenh|play|tim video|tim bai hat)\b""", RegexOption.IGNORE_CASE)
+    fun allowedFallback(text: String): Boolean {
+        val normalized = AssistantIntentParser.fold1to1(text).trim()
+        if (text.length !in 2..500 || media.containsMatchIn(normalized)) return false
+        // Do not allow the AI to be used as an action executor.
+        return true
+    }
+    fun validEndpoint(text: String): Boolean = try {
+        val uri = java.net.URI(text)
+        uri.scheme.equals("https", true) && !uri.host.isNullOrBlank() && uri.userInfo == null &&
+            uri.fragment == null && uri.port in -1..65535 && uri.host != "localhost" &&
+            !uri.host!!.endsWith(".local", true)
+    } catch (_: Exception) { false }
+
+    fun drivingQuestion(text: String): String? {
+        val s = AssistantIntentParser.fold1to1(text)
+        return when {
+            Regex("(toc do|bao nhieu km|dang chay bao nhieu)").containsMatchIn(s) -> "speed"
+            Regex("(tac duong|ket xe|tinh hinh giao thong|canh bao tren duong)").containsMatchIn(s) -> "traffic"
+            Regex("(toi dang lai xe|che do lai xe|di xe an toan)").containsMatchIn(s) -> "drive"
+            else -> null
+        }
+    }
+    fun shortReply(text: String): String = text.trim().replace(Regex("""\s+"""), " ").take(340)
+}
