+package com.carhud.aaproxy
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class MimiHotwordGateTest {
+    @Test fun neverStartsWithoutConsentPermissionVisibilityAndModel() {
+        val engine=object: MimiHotwordEngine {
+            var starts=0
+            var stops=0
+            override val modelAvailable=true
+            override fun start(onWake: () -> Unit): Boolean {starts++;return true}
+            override fun stop() {stops++}
+        }
+        val gate=MimiHotwordGate(engine)
+        assertFalse(gate.update(true,true,false) {})
+        assertFalse(gate.update(true,false,true) {})
+        assertFalse(gate.update(false,true,true) {})
+        assertEquals(0,engine.starts)
+        assertTrue(gate.update(true,true,true) {})
+        assertEquals(1,engine.starts)
+        assertFalse(gate.update(false,true,true) {})
+        assertEquals(1,engine.stops)
+    }
+}
