+package com.carhud.aaproxy
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class MimiAiPolicyTest {
+    @Test fun keepsMediaRequestsInOriginalFlow() {
+        assertFalse(MimiAiPolicy.allowedFallback("phát nhạc Sơn Tùng"))
+        assertFalse(MimiAiPolicy.allowedFallback("mở nhạc bolero"))
+        assertTrue(MimiAiPolicy.allowedFallback("giải thích biểu tượng áp suất lốp là gì"))
+    }
+    @Test fun rejectsInsecureAiEndpoints() {
+        assertFalse(MimiAiPolicy.validEndpoint("http://example.com/ai"))
+        assertFalse(MimiAiPolicy.validEndpoint("https://user:pass@example.com/ai"))
+        assertFalse(MimiAiPolicy.validEndpoint("https://localhost/ai"))
+        assertTrue(MimiAiPolicy.validEndpoint("https://example.com/api/mimi"))
+    }
+    @Test fun answersOnlyGroundedDrivingInformation() {
+        assertEquals("speed", MimiAiPolicy.drivingQuestion("Xe đang chạy bao nhiêu km trên giờ"))
+        assertEquals("traffic", MimiAiPolicy.drivingQuestion("Đường phía trước có tắc đường không"))
+        assertNull(MimiAiPolicy.drivingQuestion("Bật phim YouTube"))
+        assertEquals(340, MimiAiPolicy.shortReply("x".repeat(500)).length)
+    }
+}
