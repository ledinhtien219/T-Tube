+package com.carhud.aaproxy
+
+/**
+ * Contract for a future offline wake-word engine. None is shipped in v6.
+ * Implementations must own mic permission, lifecycle, battery budget and audio focus.
+ * Never start from BOOT_COMPLETED or while backgrounded.
+ */
+internal interface MimiHotwordEngine {
+    val modelAvailable: Boolean
+    fun start(onWake: () -> Unit): Boolean
+    fun stop()
+}
+
+/** Prevent accidental microphone capture without visible UI and opt-in. */
+internal class MimiHotwordGate(private val engine: MimiHotwordEngine) {
+    private var active = false
+    fun update(visible: Boolean, permission: Boolean, optedIn: Boolean, onWake: () -> Unit): Boolean {
+        val mayRun = visible && permission && optedIn && engine.modelAvailable
+        if (!mayRun) { if (active) engine.stop(); active = false; return false }
+        if (!active) active = engine.start(onWake)
+        return active
+    }
+    fun stop() { if (active) engine.stop(); active = false }
+}
