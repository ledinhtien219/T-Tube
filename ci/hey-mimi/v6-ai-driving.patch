+/** Minimal self-hosted HTTPS Mimi proxy. Run behind a TLS reverse proxy.
+ * Requires env OPENAI_API_KEY and MIMI_SHARED_TOKEN, optional OPENAI_MODEL.
+ * Never embed OPENAI_API_KEY in Android APK. Node >= 20.
+ */
+import http from 'node:http';
+import crypto from 'node:crypto';
+const key = process.env.OPENAI_API_KEY;
+const secret = process.env.MIMI_SHARED_TOKEN;
+if (!key || !secret) throw new Error('Configure OPENAI_API_KEY and MIMI_SHARED_TOKEN');
+const port = Number(process.env.PORT || 8080);
+const model = process.env.OPENAI_MODEL || 'gpt-4.1-mini';
+const server = http.createServer(async (req,res) => {
+  res.setHeader('Cache-Control','no-store');
+  const expected = Buffer.from(secret);
+  const actual = Buffer.from(String(req.headers['x-mimi-token'] || ''));
+  if (req.method !== 'POST' || req.url !== '/mimi' ||
+      actual.length !== expected.length || !crypto.timingSafeEqual(actual,expected)) {
+    res.writeHead(403);res.end();return;
+  }
+  let body = '';
+  try {
+    for await (const chunk of req) {
+      body += chunk.toString('utf8');
+      if (body.length > 4096) {res.writeHead(413);res.end();return;}
+    }
+    const {message,mode} = JSON.parse(body);
+    if (typeof message !== 'string' || !message.trim() || message.length > 500) {
+      res.writeHead(400);res.end();return;
+    }
+    const abort = AbortSignal.timeout(14000);
+    const upstream = await fetch('https://api.openai.com/v1/responses',{
+      signal: abort, method:'POST',
+      headers:{'Content-Type':'application/json','Authorization':`Bearer ${key}`},
+      body:JSON.stringify({
+        model, max_output_tokens: 180,
+        instructions: 'Bạn là Mimi, trợ lý tiếng Việt dùng trên xe. Trả lời ngắn gọn (tối đa 2 câu), không tạo ảo giác có dữ liệu giao thông hay GPS. Không hướng dẫn thao tác gây mất tập trung, không ra lệnh điều khiển xe. Khuyên dừng xe an toàn nếu cần xem điện thoại. Không đưa dữ liệu cá nhân vào câu trả lời.',
+        input: message
+      })
+    });
+    if(!upstream.ok)throw new Error('upstream_failure');
+    const json=await upstream.json();
+    const reply=(json.output || []).flatMap(x=>(x.content||[]).filter(y=>y.type==='output_text').map(y=>y.text)).join(' ').trim();
+    if(!reply)throw new Error('empty_reply');
+    res.writeHead(200,{'Content-Type':'application/json; charset=utf-8'});
+    res.end(JSON.stringify({reply:reply.slice(0,700)}));
+  } catch(_) {
+    res.writeHead(503,{'Content-Type':'application/json'});
+    res.end(JSON.stringify({error:'temporarily_unavailable'}));
+  }
+});
+server.listen(port,'127.0.0.1',()=>console.log('Mimi proxy listening locally on',port));
