+
+    /** One utterance can open Maps AND provide a destination. Preserve Vietnamese accents. */
+    fun mapsDestination(query: String, assistantName: String): String? {
+        val source = AssistantIntentParser.stripWake(query, assistantName).trim()
+        val normalized = AssistantIntentParser.fold1to1(source)
+            .replace(Regex("""\s+"""), " ").trim()
+        val m = directRoute.matchEntire(normalized) ?: return null
+        // fold1to1 preserves NFC character positions; avoid index drift from
+        // whitespace compression by extracting from original source when possible.
+        val raw = source.replace(Regex("""\s+"""), " ").trim()
+        val place = raw.substring(m.groups[1]!!.range.first).trim().trimEnd('.', '!', '?', ',').trim()
+        return place.takeIf { it.isNotBlank() }
+    }
 
