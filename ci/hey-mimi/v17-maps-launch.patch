+package com.carhud.aaproxy
+
+/** Predictable navigation preference; a voice route is not a media search. */
+internal object MimiNavigationPriority {
+    /** Google Maps is the default, Waze only wins when explicitly selected. */
+    fun preferredApps(preference: String, walking: Boolean): List<String> = when {
+        walking -> listOf("gmaps", "waze")
+        preference == "waze" -> listOf("waze", "gmaps")
+        else -> listOf("gmaps", "waze")
+    }
+}
