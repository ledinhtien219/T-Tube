+package com.carhud.aaproxy
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class MimiNavigationPriorityTest {
+    @Test fun googleMapsIsDefaultAndWazePreferenceIsRespected() {
+        assertEquals(listOf("gmaps", "waze"), MimiNavigationPriority.preferredApps("auto", false))
+        assertEquals(listOf("gmaps", "waze"), MimiNavigationPriority.preferredApps("gmaps", false))
+        assertEquals(listOf("waze", "gmaps"), MimiNavigationPriority.preferredApps("waze", false))
+        assertEquals(listOf("gmaps", "waze"), MimiNavigationPriority.preferredApps("waze", true))
+    }
+    @Test fun directMapsRouteRetainsAccentedDestination() {
+        val cases = mapOf(
+            "Mimi mở Google Maps dẫn đường đến sân bay Nội Bài" to "sân bay Nội Bài",
+            "Hey Mimi, mở maps đến Hồ Gươm" to "Hồ Gươm",
+            "Mimi mở google maps rồi chỉ đường tới Bến xe Mỹ Đình" to "Bến xe Mỹ Đình",
+            "Mimi mở maps tìm đường đến Aeon Tân Phú" to "Aeon Tân Phú",
+            "Mimi tìm video hướng dẫn Maps" to null,
+            "Mimi mở YouTube" to null
+        )
+        for ((spoken, expected) in cases) {
+            assertEquals(spoken, expected, MimiMapsCommandRouter.mapsDestination(spoken, "Mimi"))
+        }
+    }
+    @Test fun mapsOnCarScreenIntentIsRecognizedWithoutHijackingVideo() {
+        assertTrue(MimiMapsCommandRouter.wantsMaps("Mimi mở Google Maps trên màn hình xe", "Mimi"))
+        assertTrue(MimiMapsCommandRouter.wantsMaps("Mimi mở Maps trên Android Auto", "Mimi"))
+        assertFalse(MimiMapsCommandRouter.wantsMaps("Mimi mở video Maps trên Android Auto", "Mimi"))
+    }
+}
