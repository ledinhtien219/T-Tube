+package com.carhud.aaproxy
+
+import org.junit.Assert.*
+import org.junit.Test
+
+class MimiProVoiceRouterTest {
+    @Test fun explicitAiNeverGoesToTikTokOrYoutubeSearch() {
+        val a = MimiProVoiceRouter.route("Hỏi AI, giải thích cầu vồng", "Mimi", false, true)
+        assertTrue(a is MimiProVoiceRouter.Route.AskAi)
+        assertEquals("giải thích cầu vồng", (a as MimiProVoiceRouter.Route.AskAi).question)
+        assertTrue(MimiProVoiceRouter.route("Mimi hỏi AI kể chuyện", "Mimi", false, false) is MimiProVoiceRouter.Route.AskAi)
+        assertTrue(MimiProVoiceRouter.route("hỏi ai", "Mimi", false, true) is MimiProVoiceRouter.Route.AskAi)
+    }
+    @Test fun musicSearchIsExplicitAndOptIn() {
+        val a = MimiProVoiceRouter.route("Tìm nhạc Trịnh Công Sơn", "Mimi", false, true)
+        assertEquals("Trịnh Công Sơn", (a as MimiProVoiceRouter.Route.SearchYouTube).query)
+        assertTrue(MimiProVoiceRouter.route("Tìm nhạc Trịnh Công Sơn", "Mimi", false, false) is MimiProVoiceRouter.Route.None)
+        assertTrue(MimiProVoiceRouter.route("Mimi tìm nhạc remix", "Mimi", false, false) is MimiProVoiceRouter.Route.SearchYouTube)
+        assertTrue(MimiProVoiceRouter.route("tìm video hướng dẫn Google Maps", "Mimi", false, true) is MimiProVoiceRouter.Route.None)
+    }
+    @Test fun homeAndUnsupportedSplitAreNotAccidentalCommands() {
+        assertTrue(MimiProVoiceRouter.route("Mimi về trang chủ", "Mimi", false, true) is MimiProVoiceRouter.Route.Home)
+        assertTrue(MimiProVoiceRouter.route("chia 3 màn hình", "Mimi", false, true) is MimiProVoiceRouter.Route.None)
+        assertTrue(MimiProVoiceRouter.route("Mimi chia 3 màn hình", "Mimi", false, true) is MimiProVoiceRouter.Route.SplitUnavailable)
+        assertTrue(MimiProVoiceRouter.route("phát video chia 3 màn hình", "Mimi", true, true) is MimiProVoiceRouter.Route.None)
+        assertTrue(MimiProVoiceRouter.route("Mimi mở YouTube", "Mimi", false, true) is MimiProVoiceRouter.Route.None)
+    }
+}
