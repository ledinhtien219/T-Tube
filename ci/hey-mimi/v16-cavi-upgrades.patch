+package com.carhud.aaproxy
+
+/** V16: classify explicit AI vs media commands before TikTok/browser search routing.
+ * This only selects routing; remote model never executes app or vehicle commands.
+ */
+internal object MimiProVoiceRouter {
+    sealed class Route {
+        data class AskAi(val question: String) : Route()
+        data class SearchYouTube(val query: String) : Route()
+        object Home : Route()
+        object SplitUnavailable : Route()
+        object None : Route()
+    }
+
+    fun route(raw: String, assistantName: String, addressedByTap: Boolean, preferMusicYouTube: Boolean): Route {
+        val spoken = AssistantIntentParser.stripWake(raw.trim(), assistantName).trim()
+        val folded = AssistantIntentParser.fold1to1(spoken).lowercase()
+            .replace(Regex("""\s+"""), " ").trim()
+        val addressed = addressedByTap || AssistantIntentParser.hasWake(raw, assistantName)
+        // Deliberate 'Hỏi AI' is an unambiguous privacy opt-in, even inside TikTok.
+        val ai = Regex("""^(?:hoi ai|hoi tro ly ai|hoi mimi ai|tro chuyen voi ai|ai oi)\s*[:,]?\s*(.*)$""").matchEntire(folded)
+        if (ai != null) {
+            val start = ai.groups[1]?.range?.first ?: spoken.length
+            val question = spoken.substring(start.coerceIn(0, spoken.length)).trim().trimStart(',', ':', ' ')
+            return Route.AskAi(question)
+        }
+        if (addressed && Regex("""^(?:ve trang chu|quay ve trang chu|mo trang chu|ve t tube|quay lai dashboard)(?:\s+(?:di|nhe))?$""").matches(folded)) {
+            return Route.Home
+        }
+        if (addressed && Regex("""^(?:chia|mo)\s+(?:2|3|hai|ba)\s+man hinh(?:\s+(?:di|nhe))?$""").matches(folded)) {
+            return Route.SplitUnavailable
+        }
+        if (preferMusicYouTube || addressed) {
+            val media = Regex("""^(?:tim nhac|tim bai hat|tim ca khuc|tim video nhac|tim youtube)\s+(.+)$""").matchEntire(folded)
+            if (media != null) {
+                val start = media.groups[1]?.range?.first ?: spoken.length
+                val query = spoken.substring(start.coerceIn(0, spoken.length)).trim()
+                if (query.isNotBlank()) return Route.SearchYouTube(query)
+            }
+        }
+        return Route.None
+    }
+}
